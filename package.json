{
  "name": "granny-is-watching",
  "version": "0.1.0",
  "private": true,
  "description": "A rural Indonesian horror game of congklak and Granny's watchful gaze.",
  "author": "AnsellMaximilian",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnsellMaximilian/granny-is-watching.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite",
    "build": "vite build && node electron/build-preload.mjs",
    "test": "node --test",
    "package:win": "npm run build && electron-builder --config electron-builder.cjs --win nsis zip --x64 --publish never",
    "package:win:dir": "npm run build && electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "@babylonjs/loaders": "8.56.2",
    "@smartspectra/node-sdk": "3.5.0",
    "earcut": "3.0.2"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "semver": "7.8.6",
    "vite": "8.3.8"
  }
}
